{
  "name": "khet-laser-chess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A web-based implementation of Khet (Laser Chess) that compiles to a single HTML file",
  "scripts": {
    "play:dev": "vite --config play/vite.config.ts",
    "play:build": "vite build --config play/vite.config.ts",
    "play:test": "node --test --experimental-test-isolation=none play/test/*.test.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:single": "vite build --mode production",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"packages/*/test/*.test.ts\" \"test/*.test.js\"",
    "test:tools": "node --test --experimental-test-isolation=none --test-concurrency=1 tools/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.0",
    "qrcode": "^1.5.4",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@7.1.14",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
